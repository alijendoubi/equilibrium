# Copy to backend/.env for local development. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=gpt-6.1-sol
OPENAI_MODEL_EXPLAIN=gpt-6.1-sol
OPENAI_MODEL_RECONCILE=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
# 1 = public /explain may call OpenAI live (rate limited); 0 = cache then template
EXPLAIN_LIVE=0
EXPLAIN_RATE_PER_MINUTE=10
# Per-IP limit for public graph reads (/api/v1/search and /api/v1/graph).
QUERY_RATE_PER_MINUTE=60
# Set to the number of trusted reverse proxies that append X-Forwarded-For (Render: 1).
TRUSTED_PROXY_HOPS=0
# Shared server-only token for the Vercel frontend; do not expose with NEXT_PUBLIC_.
FRONTEND_API_TOKEN=
NCBI_API_KEY=
OMIM_API_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
