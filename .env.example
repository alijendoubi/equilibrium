# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- LLM extraction ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=gpt-6.1-sol
OPENAI_MODEL_EXPLAIN=gpt-6.1-sol
OPENAI_MODEL_RECONCILE=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
# 1 = public /explain may call OpenAI live (rate limited); 0 = cache then template
EXPLAIN_LIVE=0
EXPLAIN_RATE_PER_MINUTE=10

# --- Data sources ---
# NCBI E-utilities (PubMed etc.): raises the rate limit from 3 to 10 req/s.
# https://account.ncbi.nlm.nih.gov/settings/ -> "API Key Management"
NCBI_API_KEY=
# OMIM API: request access at https://www.omim.org/api (approval can take time; optional)
OMIM_API_KEY=

# --- Backend ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Frontend ---
# Server-side URL the Next.js server uses to reach the API (docker compose overrides to http://backend:8000)
BACKEND_URL=http://localhost:8000
# Browser-visible API URL (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
