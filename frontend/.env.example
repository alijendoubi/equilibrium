# Browser-exposed base URL of the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side base URL of the backend (e.g. http://backend:8000 inside docker compose).
BACKEND_URL=http://localhost:8000
# UI data source. "true" (default) uses the mock JSON in src/mocks; "false" calls the API.
NEXT_PUBLIC_USE_MOCKS=true
# Public base URL for Atlas calls to action from the marketing subdomain, e.g. https://mydomain.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host that serves the marketing page, e.g. home.mydomain.com. If unset, any home.* host is used.
MARKETING_HOST=home.localhost
