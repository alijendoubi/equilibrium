# Browser-exposed base URL of the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side base URL of the backend (e.g. http://backend:8000 inside docker compose).
BACKEND_URL=http://localhost:8000
# UI data source. "true" (default) uses the mock JSON in src/mocks; "false" calls the API.
NEXT_PUBLIC_USE_MOCKS=true
# Server-only secret shared with the backend (same value as backend FRONTEND_API_TOKEN). Server-side
# API calls then send the visitor IP so rate limits apply per visitor. Never prefix with NEXT_PUBLIC_.
FRONTEND_API_TOKEN=
